# readmet3xt-lab/foxhound via trustno1-coder/VIctory-NVIDIA: its launcher's set
# (scripts/play-foxhound.ps1), for a comparison under Proton with the Linux
# fork's scripts. No DLSS; 1080p rendered, upscaled to 1440p (-Res 1080to1440).
VICTORY_THIN=1
VICTORY_JOIN_PARTS=8
VICTORY_RELAY=2
VICTORY_RELAY_COPY=1
VICTORY_WIDE_BACK=1
VICTORY_CARD_REHASH_RUNS=1
VICTORY_JOIN_COPIES=1
VICTORY_CARD_STEPS=2
VICTORY_CARD_BUFFERS_MIN_KB=64
VICTORY_INDIRECT_WINDOW=1
VICTORY_INDIRECT_BATCH=2
VICTORY_UPLOAD_AHEAD=1
VICTORY_SHOW_AFTER=1
VICTORY_MAP_THREADS=1
VICTORY_WC_NO_BACK=1
VICTORY_WC_NO_BACK_MIN_KB=1024
VICTORY_SOFT_VIEWS=copies
VICTORY_TEXTURE_POOL=1
VICTORY_RIPE_BLOCKS=0
VICTORY_TEXTURE_NO_WAIT=1
VICTORY_TEXTURE_CATCHUP=0
VICTORY_TEXTURE_STAGE_MS=16
VICTORY_LEVELS_ON_DEMAND=0
VICTORY_PRELUDE_UPLOADS=1
VICTORY_SHOW_NEW_LATER=1
VICTORY_POOL_SMALL=0
VICTORY_TABLED_REREAD=1
VICTORY_QUEUE_HOST_TEXTURES=0
VICTORY_HEAP_SYNC_FIRST=1
VICTORY_SYNC_IN_PLACE=1
VICTORY_SPANS_QUICK=1
VICTORY_SYNC_FINE=1
VICTORY_HEAP_SYNC_AT_SUBMIT=1
VICTORY_AMBIENT=0.8
VICTORY_AMBIENT_AIR=1.5
VICTORY_AMBIENT_SPECULAR=1
VICTORY_EARLY_DEPTH=1
VICTORY_PIPELINE_BOOK=1
VICTORY_RENDER_1080P=1
# Measured on the previous base here: the keep-awake spinner is AMD's.
VICTORY_CARD_AWAKE=0

# Linux / this machine: the shaders NVIDIA's driver hangs on, left out in every
# build (LEAVE_OUT) and in diagnostics builds (SKIP_PIPELINES); host facts.
VICTORY_LEAVE_OUT=02384a60fda6f2d0,731a39171b568298,7115e46a79c78f98,59b1ba494f18c894,b8ca32a6899b87fb,659fe9cae59dbd88,32ed072b9f845048,fdd56d97a806bcca,17829ac71aab4e8d,559d9f0184e15fe3,a1b20bc47e3c9597,afeea48bbb9913ad,e8c962358d862e3f,7f05ddab771799a9,a53a7977fe762268,be14e72d86362031
VICTORY_SKIP_PIPELINES=7115e46a79c78f98,59b1ba494f18c894,b8ca32a6899b87fb,659fe9cae59dbd88,32ed072b9f845048,fdd56d97a806bcca,17829ac71aab4e8d,559d9f0184e15fe3,a1b20bc47e3c9597,afeea48bbb9913ad,e8c962358d862e3f,7f05ddab771799a9,a53a7977fe762268,be14e72d86362031
VICTORY_NO_WATCHDOG=1
VICTORY_PIPELINE_WAIT_MS=24
VICTORY_HOST_WAVE=32
VICTORY_VIEW_LIMIT=999999
VICTORY_TEXTURE_ROOM_PERCENT=95
