# trustno1-coder/VIctory-NVIDIA's play set (scripts/play-nvidia.ps1), for a
# comparison under Proton with the Linux fork's scripts. No upscaler (DLSS
# under Proton is a project of its own); Series X as the fork's own runs.
# Textures not waited for (as Vice-Tay): run C, mean 475 -> 193 ms, frames over
# 1 s 9 -> 4, texture time p90 272 -> 8 ms; a texture may show a moment late.
VICTORY_TEXTURE_NO_WAIT=1
VICTORY_RELAY=2
VICTORY_CARD_STEPS=2
VICTORY_WIDE_BACK=1
VICTORY_CARD_REHASH_RUNS=1
VICTORY_JOIN_COPIES=1
VICTORY_INDIRECT_WINDOW=1
VICTORY_RELAY_COPY=1
VICTORY_FETCH_CHECK=1
VICTORY_INDIRECT_BATCH=2
VICTORY_MAP_THREADS=1
VICTORY_TITLE_PRIORITIES=0
VICTORY_SHOW_AFTER=1
# The stand-in for the indirect light the title traces rays for (ray tracing is
# off): 0 left indoor walls, characters and clothes black; 0.8 as Vice-Tay.
VICTORY_AMBIENT=0.8
VICTORY_THIN=1
VICTORY_JOIN_PARTS=8
VICTORY_UPLOAD_AHEAD=1
VICTORY_AMBIENT_AIR=1.5
VICTORY_NAN_SCRUB=1
VICTORY_PIPELINE_WAIT_MS=24
VICTORY_DYNAMIC_SLOTS=524288
VICTORY_CARD_BUFFERS_MIN_MB=1
VICTORY_CARD_BUFFERS_MB=1536

# Linux / this machine (as the Linux fork's play.env): shaders the driver hangs
# or crashes on, the host facts for the warm-up, the NVIDIA shader cache.
VICTORY_NO_WATCHDOG=1
VICTORY_SKIP_PIPELINES=7115e46a79c78f98,59b1ba494f18c894,b8ca32a6899b87fb,659fe9cae59dbd88,32ed072b9f845048,fdd56d97a806bcca,17829ac71aab4e8d,559d9f0184e15fe3,a1b20bc47e3c9597,afeea48bbb9913ad,e8c962358d862e3f,7f05ddab771799a9,a53a7977fe762268,be14e72d86362031
VICTORY_FRAME_LOG=1
FORK_PLAY_ARGS=--console series-x
VICTORY_TEXTURE_ROOM_PERCENT=95
VICTORY_HOST_WAVE=32
VICTORY_VIEW_LIMIT=999999
__GL_SHADER_DISK_CACHE_PATH=~/.local/share/flamingo-fork/nvidia-cache
__GL_SHADER_DISK_CACHE_SIZE=10737418240
VICTORY_OUTPUT=1920x1080

# Measured here (run B, 2026-11-27): the Linux fork's Wine-side settings and
# Vice-Tay's 4070 thread counts; the keep-awake spinner is for AMD only.
VICTORY_VIEW_GUARD=0
VICTORY_CARD_AWAKE=0
VICTORY_WIDE_TEXTURES=1
VICTORY_WIDE_MERGE=1
VICTORY_THIN_THREADS=8
VICTORY_UNDER_THREADS=6
VICTORY_LAND_THREADS=4
